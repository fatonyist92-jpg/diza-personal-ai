{
  "name": "Bloks Pocket Indonesian CPU Voice Lab (no production changes)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "bash diza-live/pocket-cpu/setup_codespace.sh",
  "remoteEnv": {
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Pocket CPU voice (private, bearer protected)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
