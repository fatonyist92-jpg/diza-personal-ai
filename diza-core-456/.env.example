# Diza Core state
DIZA_STATE_DIR=.diza-state
DIZA_TASK_POLL_MS=5000

# Groq Free account
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FREE_PLAN_CONFIRMED=false

# Google Gemini API Free Tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER_CONFIRMED=false

# Mistral Free Mode
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FREE_MODE_CONFIRMED=false

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Optional trial/development reserves
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FREE_TRIAL_CONFIRMED=false
DIZA_ENABLE_CEREBRAS_TRIAL=false

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_DEVELOPER_PROGRAM_CONFIRMED=false
DIZA_ENABLE_NVIDIA_DEV=false

COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
COHERE_TRIAL_KEY_CONFIRMED=false
DIZA_ENABLE_COHERE_TRIAL=false

# OpenRouter is intentionally not enabled by default.
# Its current terms are incompatible with the intended competing
# multi-provider service architecture.
